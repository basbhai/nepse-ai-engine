[Unit]
Description=NEPSE AI — Claude Wait-Condition Monitor Timer (1:15 PM NST = 07:30 UTC, after 2nd indicator refresh)
Documentation=file:///home/shanvi/nepse-engine/agents/claude_wait_monitor/wait_monitor_prompt.md

[Timer]
# Runs 15 min after nepse-indicators-refresh.timer (1:00 PM NST = 07:15 UTC),
# the second intraday indicator refresh of the day, so the monitor always
# reads fresh post-refresh data rather than the stale 10:15am snapshot.
# Fires every day; the wrapper script itself gates on calendar_guard.is_trading_day()
# so holidays are correctly skipped, not just weekends (unlike a hardcoded Mon-Fri
# OnCalendar, which would miss holiday awareness).
OnCalendar=*-*-* 07:30:00 UTC
Persistent=true
AccuracySec=30s

[Install]
WantedBy=timers.target
