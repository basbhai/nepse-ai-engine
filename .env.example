# ─────────────────────────────────────────────────────────────────────────────
# NEPSE AI Engine — Environment Variables (SAMPLE / DOCUMENTATION ONLY)
# Copy this to .env and fill in ALL values before running setup/install.sh
# NEVER commit the real .env to git — it is in .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://<user>:<password>@127.0.0.1:5432/nepse_engine
BACKTEST_DATABASE_URL=postgresql://<user>:<password>@127.0.0.1:5432/nepse_engine_dev
DATABASE_URL_NEON=postgresql://<user>:<password>@<neon-host>/<db>?sslmode=require&channel_binding=require

# ── Gemini AI ─────────────────────────────────────────────────────────────────
# Multiple keys = round-robin across Gemini accounts to spread free-tier quota.
GEMINI_API_KEY_1=<gemini-api-key-account-1>
GEMINI_API_KEY_2=<gemini-api-key-account-2>
GEMINI_API_KEY_3=<gemini-api-key-account-3>
GEMINI_MODEL=gemini-2.5-flash-lite

# ── OpenRouter (Claude + GPT + DeepSeek) ─────────────────────────────────────
OPENROUTER_API_KEY=<openrouter-api-key>
CLAUDE_MODEL=anthropic/claude-sonnet-4-6
GPT_MODEL=openai/gpt-5.4
DEEPSEEK_MODEL=deepseek/deepseek-r3

# ── TMS49 Broker (legacy — used by modules/tms_scraper.py) ──────────────────
TMS_USERNAME=<tms49-username>
TMS_PASSWORD=<tms49-password>
TMS_REQUEST_OWNER=<tms49-request-owner-id>
TMS_CLIENT_ID=<tms49-client-id>

# ── TMS Roadshow — LIVE ORDER account ────────────────────────────────────────
# Used for: place_order, place_sell_order, fetch_order_book, get_portfolio
# (broker-side, RSL-only — not used for live-portfolio sync, see meroshare.py).
# Everything that touches or informs an actual order stays on this account.
TMS_ROADSHOW_USER=<roadshow-order-account-username>
TMS_ROADSHOW_PASS=<roadshow-order-account-password>
TMS_ROADSHOW_WATCH_ID=11120
TMS_ROADSHOW_ACNT_ID=<roadshow-order-account-numeric-id>
ATRAD_SIM_ENABLED=true

# ── TMS Roadshow — DATA-FETCHER account ──────────────────────────────────────
# Used for: fetch_market_watch, fetch_trade_stats, fetch_nepse_index,
# get_ltp_live, fetch_trades_of_day. Segregated from the order account so
# bulk data polling never shares a session with live orders.
# Falls back to TMS_ROADSHOW_USER/PASS if unset.
TMS_ROADSHOW_DATA_USER=<roadshow-data-account-username>
TMS_ROADSHOW_DATA_PASS=<roadshow-data-account-password>

# ── Meroshare (CDSC portal — cost-basis + real DEMAT balance for live portfolio) ──
MEROSHARE_USERNAME=<meroshare-username>
MEROSHARE_PASSWORD=<meroshare-password>
MEROSHARE_DP_ID=<meroshare-dp-id>
MEROSHARE_DEMAT=<demat-account-number>
MEROSHARE_CLIENT_CODE=<meroshare-client-code>

# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=<telegram-bot-token>
TELEGRAM_CHAT_ID=<admin-telegram-chat-id>
TELEGRAM_ERROR_BOT=<telegram-error-bot-token>

# ── Email (optional) ─────────────────────────────────────────────────────────
EMAIL_USER=<gmail-address>
EMAIL_APP_PASS=<gmail-app-password>
EMAIL_RECEIVER=<comma-separated-recipient-emails>

# ── Trading mode ─────────────────────────────────────────────────────────────
# This is also stored in the DB settings table.
# The DB value takes precedence unless you pass -paper or -live on the CLI.
PAPER_MODE=true

# ── For DeepSeek Playwright ───────────────────────────────────────────────────
DEEPSEEK_EMAIL=<deepseek-login-email>
DEEPSEEK_PASSWORD=<deepseek-login-password>

# ── For Sharehub broker scraper ───────────────────────────────────────────────
SHAREHUB_EMAIL=<sharehub-login-email>
SHAREHUB_PASSWORD=<sharehub-login-password>

# ── For Discord ───────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=<discord-bot-token>
DISCORD_ADMIN_ID=<discord-admin-user-id>
DISCORD_CHANNEL_ID=<discord-channel-id>
DISCORD_GUILD_ID=<discord-guild-id>
DISCORD_WEBHOOK_URL=<discord-webhook-url>

# ── For Dashboard auth (web_ui/dashboard_api.py) ─────────────────────────────
# Requests from localhost/LAN/tailnet are trusted automatically (no login).
# Requests arriving on the public Tailscale Funnel hostname must either send
# this value as an "X-API-Key" header, or log in at /login with it as the
# password (session cookie lasts 30 days after that).
DASHBOARD_AUTH_SECRET=<random-dashboard-auth-secret>
